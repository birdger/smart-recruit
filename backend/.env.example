# ============================================================
# SmartRecruit 环境变量模板
# 复制为 .env 或导出到系统环境后再启动服务
# 仓库内不含任何真实地址与凭据，请自行填写
# ============================================================

# ---------- MySQL（7 个业务库）----------
DB_USERNAME=root
DB_PASSWORD=

# ---------- Redis（验证码 / 缓存 / 限流 / 分布式锁）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Nacos（注册中心 + 配置中心，可选）----------
# 多开发者共用一个 Nacos 时，请用 COMPUTER_ID 区分 namespace/group，避免实例互相覆盖
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=
COMPUTER_ID=dev-local

# ---------- RustFS / S3 兼容对象存储（简历、合同、头像）----------
RUSTFS_ENDPOINT=127.0.0.1
RUSTFS_PORT=9091
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=smart-recruit-dev

# ---------- 邮件（通知、测评邀请、合同签署链接）----------
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- JWT ----------
# 网关与所有业务服务必须使用同一个 secret；长度 >= 64 字节
JWT_SECRET_KEY=
# 服务间内部调用专用
INTERNAL_JWT_SECRET=

# ---------- LLM（AI 引擎）----------
QWEN_API_KEY=
DEEPSEEK_API_KEY=

# ---------- Elasticsearch（人才库语义检索，可选）----------
TALENT_ES_URIS=http://127.0.0.1:9200
TALENT_ES_USERNAME=
TALENT_ES_PASSWORD=
